# Environment Mode
NODE_ENV=production

# Server Port
PORT=10000

# MongoDB Database Connection String
# Render automatically injects this if connected via render.yaml
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/amicommerce?retryWrites=true&w=majority

# Secret key for JWT signing (Minimum 32 characters recommended)
JWT_SECRET=super_secret_jwt_key_replace_this_for_production

# CORS allowed frontend origin URL
CORS_ORIGIN=https://ami-commerce-app.onrender.com